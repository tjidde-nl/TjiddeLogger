<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors Condition="'$(TreatWarningsAsErrors)' == ''">false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- NuGet package metadata -->
    <PackageId>Tjidde.Logging</PackageId>
    <Version>1.0.1</Version>
    <Authors>Tjidde Nieuwenhuizen</Authors>
    <Company>Tjidde Nieuwenhuizen</Company>
    <Product>Tjidde.Logging</Product>
    <Description>Standardized, structured logging for .NET applications. Integrates with Microsoft.Extensions.Logging and provides consistent output, customer context, sensitive data masking, and improved exception formatting.</Description>
    <PackageTags>logging;tjidde;structured-logging;microsoft-extensions-logging</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/tjidde-nl/TjiddeLogger</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/tjidde-nl/TjiddeLogger</PackageProjectUrl>
    <Copyright>Copyright © 2026 Tjidde Nieuwenhuizen</Copyright>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <!-- PackageReleaseNotes (the "Release Notes" tab on nuget.org) is set by the
         SetReleaseNotesFromChangelog target below. -->

    <!-- Package validation: dotnet pack fails on a breaking change compared with the last
         published version (downloaded from nuget.org). Raise the baseline after every release. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.1</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!--
    Release notes for this version only: the "## [<PackageVersion>]" section of CHANGELOG.md
    (up to the next "## [" heading), followed by a link to the full changelog.
    If the section does not exist, the notes contain only the link; the build never fails on it.
    Runs during pack, after -p:Version=... has been applied.
  -->
  <Target Name="SetReleaseNotesFromChangelog" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <_ChangelogPath>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', '..', 'CHANGELOG.md'))</_ChangelogPath>
      <_ChangelogUrl>https://github.com/tjidde-nl/TjiddeLogger/blob/main/CHANGELOG.md</_ChangelogUrl>
      <_ChangelogText></_ChangelogText>
      <_ChangelogText Condition="Exists('$(_ChangelogPath)')">$([System.IO.File]::ReadAllText('$(_ChangelogPath)'))</_ChangelogText>
      <_ChangelogText>$(_ChangelogText.Replace('&#13;', ''))</_ChangelogText>
      <_ChangelogVersionPattern>(?m)^## \[$([System.Text.RegularExpressions.Regex]::Escape('$(PackageVersion)'))\][^\n]*\n(?:(?!## \[).*\n?)*</_ChangelogVersionPattern>
      <_ChangelogSection>$([System.Text.RegularExpressions.Regex]::Match('$(_ChangelogText)', '$(_ChangelogVersionPattern)').Value.Trim())</_ChangelogSection>
      <PackageReleaseNotes>Full changelog: $(_ChangelogUrl)</PackageReleaseNotes>
      <PackageReleaseNotes Condition="'$(_ChangelogSection)' != ''">$(_ChangelogSection)

Full changelog: $(_ChangelogUrl)</PackageReleaseNotes>
    </PropertyGroup>
  </Target>

  <!-- Use framework-appropriate package versions to avoid unsupported TFM warnings -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net7.0'">
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <!-- System.TimeProvider is built in from net8.0; net7.0 gets it from this package -->
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.5" />
  </ItemGroup>

  <!--
    Public API tracking: PublicAPI.Shipped.txt holds the API of the last release (1.0.1),
    PublicAPI.Unshipped.txt everything added since. Every public API change must be recorded
    there (RS0016/RS0017); move Unshipped to Shipped after a release.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\AI-INTEGRATION.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
