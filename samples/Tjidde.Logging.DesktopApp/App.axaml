<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:Tjidde.Logging.DesktopApp.Converters"
             x:Class="Tjidde.Logging.DesktopApp.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <converters:LogLevelColorConverter x:Key="LevelColorConverter" />
        <converters:LogLevelLabelConverter x:Key="LevelLabelConverter" />
    </Application.Resources>

</Application>
